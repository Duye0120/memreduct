<Application x:Class="MemReduct.Fluent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F4F7" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="#E3E3E9" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#747480" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#5948E9" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#5948E9" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5141D8" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4939C7" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#5948E9" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#5141D8" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4939C7" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="White" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#25252C" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#D3D3DC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#19191D" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#242429" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="#3B3B44" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#AFAFBB" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#B5A5FF" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B5A5FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#A89AEE" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#9B8DDD" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#B5A5FF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#A89AEE" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#9B8DDD" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#303037" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#EEEEF2" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#464650" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CornerRadius x:Key="AppControlCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Margin" Value="0,8,0,12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
